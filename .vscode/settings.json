        "docker",
        "node -e \"const{Client}=require('pg');(async()=>{for(const u of[{user:'postgres',database:'postgres'},{user:'postgres',database:'postgres',password:'postgres'}]){const c=new Client({host:'localhost',port:5432,connectionTimeoutMillis:4000,...u});try{await c.connect();const r=await c.query(\\\"select current_user, current_setting('data_directory') as dd, version()\\\");console.log('OK',JSON.stringify(u.password?{...u,password:'***'}:u),r.rows[0]);await c.end();}catch(e){console.log('FAIL',JSON.stringify(u.password?{...u,password:'***'}:u),e.code,e.message);}}})()\"",
        "powershell",
        "powershell -NoProfile -Command \"Get-Command docker | Select-Object -ExpandProperty Source; Get-Process 'Docker Desktop','com.docker.backend' -ErrorAction SilentlyContinue | Select-Object Name; Test-Path \\\"$env:LOCALAPPDATA\\Docker\\\"; Test-Path \\\"$env:ProgramFiles\\Docker\\\"\"",
        "curl",
        "sed",
        "powershell -NoProfile -Command (Get-Content apps/web/src/app/i18n/strings.en.ts)[248..520]",
        "powershell -NoProfile -Command \"Select-String -Path apps/web/src/app/i18n/strings.en.ts -Pattern \\\"^  'host\\\\.\\\" | Measure-Object -Line\"",
        "powershell -NoProfile -Command \"Select-String -Path apps/web/src/app/i18n/strings.en.ts -Pattern \\\"^  'host\\\" -Raw\"",
        "node -e \"const s=require('fs').readFileSync('apps/web/src/app/i18n/strings.en.ts','utf8');['display.joined','host.readyCount','host.answerCount','host.ceremony.step','host.progress.lobby','host.roundOf','host.eventTime','host.roundTime','host.online','host.socket','host.more','play.startsIn','display.joinPrompt'].forEach(k=>{const m=s.match(new RegExp(\\\"^  '\\\"+k.replace(/\\./g,'\\\\\\\\.')+\\\"':.*$\\\",'m'));console.log(m?m[0]:'MISSING '+k)})\"",
        "node -e \"const fs=require('fs');for(const f of ['part1','part2','part3']){const s=fs.readFileSync('apps/web/src/app/i18n/strings.ar.'+f+'.ts','utf8');const i=s.indexOf(\\\"'host.export\\\");console.log(f, i);if(i>-1)console.log(s.slice(i-100,i+700));}\"",
        "powershell -NoProfile -Command \"Select-String -Path apps/web/src/app/i18n/strings.en.ts -Pattern \\\"^\\s+'host\\.|^\\s+'action\\.|^\\s+'common\\.\\\" | ForEach-Object { $_.Line.Trim() }\"",
        "set DB_DRIVER=embedded",
        "powershell -NoProfile -Command \"Select-String -Path apps/web/src/app/participant/play.component.ts,apps/web/src/app/participant/join.component.ts,apps/web/src/app/core/storage.ts -Pattern 'connectParticipant|participantId|ident' | ForEach-Object { \\\"$($_.Filename):$($_.LineNumber): $($_.Line.Trim())\\\" }\""
    ]
}