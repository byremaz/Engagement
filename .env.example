# Copy to .env and fill in real values. Never commit .env.
# Generate each secret separately, e.g.: openssl rand -hex 24
# --- PostgreSQL (docker-compose + API) ---
POSTGRES_DB=asas_challenge
POSTGRES_USER=asas
POSTGRES_PASSWORD=
# If a PostgreSQL server is already installed on the machine it owns 5432;
# publish the container on 5433 instead and keep DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgres://asas:<POSTGRES_PASSWORD>@localhost:5432/asas_challenge

# --- API ---
PORT=3000
# Comma-separated allowed browser origins (Angular dev server + event display machine)
CORS_ORIGINS=http://localhost:4200
# Host dashboard credential; a long random string. Required - the API refuses to boot without it.
HOST_ACCESS_KEY=
# Secret used to sign participant/display session tokens (min 32 chars).
# Must be DIFFERENT from HOST_ACCESS_KEY - distinct purposes, distinct secrets.
TOKEN_SECRET=
# Public base URL printed into the lobby QR code, e.g. https://challenge.example.com
PUBLIC_WEB_URL=http://localhost:4200

# --- Deployment (see docs/deploy-render.md) ---
# On Render the API serves the built Angular bundle from the same origin, so
# CORS_ORIGINS stays empty and no extra host is needed. Override the bundle
# location only if it is not at apps/web/dist/web/browser.
# WEB_ROOT=/opt/render/project/src/apps/web/dist/web/browser
# A managed database over the public internet needs TLS; append sslmode=require
# to DATABASE_URL (Render's internal URL does not need it).
