{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "db/*.sql",
        "outDir": "dist/apps/api/src"
      }
    ]
  },
  "entryFile": "apps/api/src/main"
}
