{
  "name": "@asas/api",
  "version": "0.1.0",
  "private": true,
  "description": "ASAS Challenge backend - NestJS REST (/v1) + WebSocket gateway, PostgreSQL persistence",
  "scripts": {
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:provision": "tsx src/db/provision-local.ts",
    "db:diagnose": "tsx src/db/diagnose-connection.ts",
    "db:probe": "tsx src/db/probe-superuser.ts"
  },
  "dependencies": {
    "@asas/shared": "*",
    "@electric-sql/pglite": "^0.2.17",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
